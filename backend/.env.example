# Groundwater AI Agent - Environment Configuration
# Copy this file to .env and fill in values

# Application Settings
APP_NAME=Groundwater AI Agent
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=sqlite:///./data/database/groundwater.db
DATABASE_PATH=./data/database/groundwater.db

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: LLM API (for enhanced NLP - system works without this)
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here
LLM_PROVIDER=rule_based

# Data Settings
DATA_DIR=./data/raw
PROCESSED_DIR=./data/processed

