# Groundwater AI Agent - Environment Configuration
# Copy this file to .env and configure your keys

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="Groundwater AI Agent"
APP_VERSION=2.0.0
DEBUG=false

# ============================================================================
# Database Configuration (Read-Only Parameterized SQLite)
# ============================================================================
DATABASE_URL=sqlite:///./data/database/groundwater.db
DATABASE_PATH=./data/database/groundwater.db

# ============================================================================
# CORS Allowed Origins
# ============================================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Agentic & Generative AI Configuration
# ============================================================================
# LLM Provider options: gemini | openai | anthropic | mock
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash

# API Keys (Never commit actual keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent Execution Bounds
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
AGENTIC_ENABLED=true

# Data Paths
DATA_DIR=./data/raw
PROCESSED_DIR=./data/processed
